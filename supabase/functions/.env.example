# Copy this file to supabase/functions/.env for LOCAL Edge Function
# development only (used via --env-file). Never commit the real .env.
# The deployed function reads the secret set with:
#   npx supabase secrets set GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional override of the server-side Gemini model (defaults to
# gemini-flash-latest, Google's rolling alias for the current flash model).
# GEMINI_MODEL=gemini-flash-latest

# Comma-separated list of browser origins allowed to call the function.
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed, so
# this is only needed for deployed frontends. No wildcard is ever used.
#   npx supabase secrets set ALLOWED_ORIGINS=https://your-app.example.com
# ALLOWED_ORIGINS=https://your-app.example.com
