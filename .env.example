# Copy this file to .env and fill in your own Supabase project values.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# These two variables are the ONLY ones the frontend needs. The anon /
# publishable key is designed to be visible in the browser bundle; actual
# data protection comes from Supabase Row Level Security.
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never put these in this file, in .env, or in any VITE_ variable:
#   - GEMINI_API_KEY        → Supabase Edge Function secret (server-side only).
#                             See supabase/functions/.env.example.
#   - service_role / secret keys → server-side only, never in a browser app.
#   - SUPABASE_ACCESS_TOKEN (sbp_...) → a personal account credential for the
#                             Supabase CLI. Authenticate with `npx supabase
#                             login` so it is stored in your OS credential
#                             manager instead of a project file.
